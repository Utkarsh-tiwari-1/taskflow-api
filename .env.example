# Copy this file to .env and set a unique random secret (at least 32 characters).
JWT_SECRET=replace-this-with-a-random-secret-at-least-32-characters
JWT_EXPIRATION_MINUTES=60

DB_HOST=localhost
DB_PORT=3306
DB_NAME=taskflow
DB_USERNAME=taskflow
DB_PASSWORD=taskflow

# Optional first-admin bootstrap. Leave both unset to disable bootstrap.
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=use-a-strong-password-here
